{
  "manifest_version": 3,
  "name": "Alttab",
  "version": "0.1.0",
  "description": "Abas e miniaturas para o alternador Option+Tab.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
